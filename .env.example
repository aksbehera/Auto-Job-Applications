# ---- Claude API (role summaries + weekly requirements analysis) ----
ANTHROPIC_API_KEY=
# Optional: override the model used for summaries/analysis.
# SUMMARY_MODEL=claude-sonnet-4-5

# ---- Apify (job discovery across platforms) ----
APIFY_TOKEN=

# ---- Google Sheet (system of record + dedupe memory) ----
# The service account that reads/writes the Sheet. Use ONE of these:
#   - raw JSON (best for GitHub Actions secrets): paste the whole key file
GOOGLE_SERVICE_ACCOUNT_JSON=
#   - or a path to the key file (best for local runs)
GOOGLE_SERVICE_ACCOUNT_FILE=
# The target Sheet. Defaults to the one created during setup; override if needed.
# JOBS_SHEET_ID=1mTNmTNJOnaUq-31XfapO36ZSY2CNLZP_7isq3KJTN3A

# ---- Email (Gmail SMTP) ----
# Generate an app password at https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Digest recipient(s), comma-separated. In GitHub Actions this is set in the
# workflow env, not here.
DIGEST_RECIPIENT=aksbehera@gmail.com
